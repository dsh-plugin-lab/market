{
  "market": {
    "title": {
      "en": "DSH Plugin Lab",
      "zh": "DSH 插件实验室"
    },
    "description": {
      "en": "Plugins built by dsh-plugin-lab for DeepSeek Harness: tools the model can call, models to run on, additions to the interface, and repairs to how a turn runs.",
      "zh": "dsh-plugin-lab 出品的 DeepSeek Harness 插件：模型可调用的工具、可接入的模型、界面增强，以及让一轮对话不中途停下的修补。"
    },
    "indexUrl": "https://dsh-plugin-lab.github.io/market/index.json"
  },
  "metadata": {
    "categories": {
      "tools": {
        "title": { "en": "Tools", "zh": "工具" }
      },
      "models": {
        "title": { "en": "Models", "zh": "模型" }
      },
      "ui": {
        "title": { "en": "Interface", "zh": "界面" }
      },
      "runtime": {
        "title": { "en": "Runtime", "zh": "运行时" }
      }
    },
    "labels": {
      "local": {
        "title": { "en": "Local", "zh": "本地" }
      },
      "online": {
        "title": { "en": "Online", "zh": "在线" }
      },
      "byok": {
        "title": { "en": "BYOK", "zh": "自备密钥" }
      }
    },
    "sortKeys": {
      "stars": {
        "title": { "en": "GitHub stars", "zh": "GitHub 星标" },
        "order": "desc"
      }
    }
  },
  "build": {
    "includePrerelease": true,
    "maxVersionsPerPlugin": 0,
    "localTimeZones": ["Asia/Shanghai", "Europe/London", "America/Los_Angeles"],
    "keywordBlocklist": ["dsh", "deepseek-harness", "dsh-plugin"],
    "maxKeywords": 12,
    "pruneUnusedMetadata": true
  },
  "keywordRules": {
    "category": {
      "models": ["llm", "models", "workbuddy"],
      "ui": ["ui", "sidebar", "balance"],
      "tools": ["search", "zhihu", "debugging", "diagnostics", "tool"],
      "runtime": ["reasoning", "auto-continue", "rescue"]
    }
  },
  "plugins": {
    "dsh-zhihu-search": {
      "category": "tools",
      "labels": ["online", "byok"],
      "sortKeys": { "stars": { "githubStars": true } }
    },
    "dsh-ds-balance": {
      "category": "ui",
      "labels": ["online"],
      "sortKeys": { "stars": { "githubStars": true } }
    },
    "dsh-dsml-rescue": {
      "category": "runtime",
      "labels": ["local"],
      "sortKeys": { "stars": { "githubStars": true } }
    },
    "dsh-plugin-debugging": {
      "category": "tools",
      "labels": ["local"],
      "keywords": ["debugging", "diagnostics", "reload", "troubleshooting"],
      "sortKeys": { "stars": { "githubStars": true } }
    },
    "dsh-workbuddy-bridge": {
      "category": "models",
      "labels": ["local"],
      "sortKeys": { "stars": { "githubStars": true } }
    }
  }
