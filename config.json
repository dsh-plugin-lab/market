{
  "market": {
    "title": {
      "en": "DSH Plugin Lab",
      "zh": "DSH 插件实验室"
    },
    "description": {
      "en": "Plugins built by dsh-plugin-lab for DeepSeek Harness: tools the model can call, models to run on, and additions to the interface.",
      "zh": "dsh-plugin-lab 出品的 DeepSeek Harness 插件：模型可调用的工具、可接入的模型，以及界面增强。"
    },
    "indexUrl": "https://dsh-plugin-lab.github.io/market/index.json"
  },
  "metadata": {
    "categories": {
      "tools": {
        "title": { "en": "Tools", "zh": "工具" }
      },
      "models": {
        "title": { "en": "Models", "zh": "模型" }
      },
      "ui": {
        "title": { "en": "Interface", "zh": "界面" }
      }
    },
    "labels": {
      "local": {
        "title": { "en": "Local", "zh": "本地" }
      },
      "online": {
        "title": { "en": "Online", "zh": "在线" }
      },
      "zero-config": {
        "title": { "en": "Zero config", "zh": "零配置" }
      },
      "needs-key": {
        "title": { "en": "Needs a key", "zh": "需自备密钥" }
      }
    },
    "sortKeys": {
      "stars": {
        "title": { "en": "GitHub stars", "zh": "GitHub 星标" },
        "order": "desc"
      }
    }
  },
  "build": {
    "includePrerelease": true,
    "maxVersionsPerPlugin": 5,
    "keywordBlocklist": ["dsh", "deepseek-harness", "dsh-plugin"],
    "maxKeywords": 12,
    "pruneUnusedMetadata": true
  },
  "keywordRules": {
    "category": {
      "models": ["llm", "models", "workbuddy"],
      "ui": ["ui", "sidebar", "balance"],
      "tools": ["search", "zhihu", "debugging", "diagnostics", "tool"]
    }
  },
  "plugins": {
    "dsh-zhihu-search": {
      "category": "tools",
      "labels": ["online", "needs-key"],
      "sortKeys": { "stars": { "githubStars": true } }
    },
    "dsh-ds-balance": {
      "category": "ui",
      "labels": ["online", "zero-config"],
      "sortKeys": { "stars": { "githubStars": true } }
    },
    "dsh-plugin-debugging": {
      "category": "tools",
      "labels": ["local", "zero-config"],
      "keywords": ["debugging", "diagnostics", "reload", "troubleshooting"],
      "sortKeys": { "stars": { "githubStars": true } }
    },
    "dsh-workbuddy-bridge": {
      "category": "models",
      "labels": ["local", "zero-config"],
      "sortKeys": { "stars": { "githubStars": "dsh-plugin-lab/dsh-workbuddy-bridge" } },
      "repository": {
        "url": "https://github.com/dsh-plugin-lab/dsh-workbuddy-bridge"
      },
      "homepage": "https://github.com/dsh-plugin-lab/dsh-workbuddy-bridge#readme"
    }
  }
}
