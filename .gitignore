# Dependencies
node_modules/

# Build output: regenerated by `pnpm run build`, deployed by the workflow, never committed.
# The index is a function of plugins.txt + config.json + what npm publishes, so a stale copy under
# version control would be a second source of truth.
/public/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local credentials: never commit these
.env
.env.*

# Build diagnostics: read by check and CI, uploaded as an artifact, never committed.
/build/
